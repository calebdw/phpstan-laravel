includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - extension.neon
parameters:
    level: 8
    phpVersion: 80300
    paths:
        - src
    ignoreErrors:
        # Both SQL parsers are optional, and CI analyses the package with each
        # one uninstalled to prove the other can carry the suite alone. In that
        # run the missing library's adapter references classes that genuinely
        # are not there. Scoped to the adapters, which exist only to call
        # into their library, so nothing else is hidden.
        - identifier: class.notFound
          path: src/Schema/Sql/IamcalSqlParser.php
          reportUnmatched: false
        - identifier: class.notFound
          path: src/Schema/Sql/PhpMyAdminSqlParser.php
          reportUnmatched: false
        - identifier: class.notFound
          path: src/Schema/Sql/PostgresSqlParser.php
          reportUnmatched: false
