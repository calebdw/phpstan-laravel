parameters:
  universalObjectCratesClasses:
    - Illuminate\Http\Request
    - Illuminate\Support\Optional
  earlyTerminatingFunctionCalls:
    - abort
    - dd
  mixinExcludeClasses:
    - Eloquent
  bootstrapFiles:
    - bootstrap.php
  autowiredServiceDirectories: [src]
  laravel:
    rules:
      authInRequestScope: false
      configAccessor: true
      envCallOutsideConfig: true
      missingTranslation: false
      modelAppends: true
      modelForwardingToBuilder: false
      modelMake: true
      modelMethodVisibility: false
      modelStaticForwardingToBuilder: false
      octaneCompatibility: false
      unnecessaryCollectionCall:
        enabled: true
        only: []
        except: []
      unnecessaryEnumerableToArrayCall: true
      unusedView: false
    migrationDirectories: []
    schemaDirectories: []
    scanMigrations: true
    scanSchema: true
    sqlParser: auto
    configDirectories: []
    translationDirectories: []
    viewDirectories: []
    staticMacroClasses:
      - Illuminate\Support\Arr
      - Illuminate\Support\Str
      - Illuminate\Support\Number
      - Illuminate\Support\Benchmark
      - Illuminate\Validation\Rule
    modelPropertyType: false
    strictContracts: false

parametersSchema:
  laravel: structure([
    rules: structure([
      authInRequestScope: bool()
      configAccessor: bool()
      envCallOutsideConfig: bool()
      missingTranslation: bool()
      modelAppends: bool()
      modelForwardingToBuilder: bool()
      modelMake: bool()
      modelMethodVisibility: bool()
      modelStaticForwardingToBuilder: bool()
      octaneCompatibility: bool()
      unnecessaryCollectionCall: structure([
        enabled: bool()
        only: listOf(string())
        except: listOf(string())
      ])
      unnecessaryEnumerableToArrayCall: bool()
      unusedView: bool()
    ])
    migrationDirectories: listOf(string())
    schemaDirectories: listOf(string())
    scanMigrations: bool()
    scanSchema: bool()
    sqlParser: anyOf('auto', 'iamcal', 'phpmyadmin', 'postgres')
    configDirectories: listOf(string())
    translationDirectories: listOf(string())
    viewDirectories: listOf(string())
    staticMacroClasses: listOf(string())
    modelPropertyType: bool()
    strictContracts: bool()
  ])

expandRelativePaths:
  - '[parameters][laravel][configDirectories][]'
  - '[parameters][laravel][migrationDirectories][]'
  - '[parameters][laravel][schemaDirectories][]'
  - '[parameters][laravel][translationDirectories][]'
  - '[parameters][laravel][viewDirectories][]'

services:
  # Registered here rather than through #[AutowiredService]: the attribute registers a class
  # once, and these are registered several times with different arguments.
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ContainerArrayAccessDynamicMethodReturnTypeExtension
    arguments: {className: Illuminate\Contracts\Container\Container}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ContainerArrayAccessDynamicMethodReturnTypeExtension
    arguments: {className: Illuminate\Container\Container}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ContainerArrayAccessDynamicMethodReturnTypeExtension
    arguments: {className: Illuminate\Foundation\Application}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ContainerArrayAccessDynamicMethodReturnTypeExtension
    arguments: {className: Illuminate\Contracts\Foundation\Application}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ConfigDynamicMethodReturnTypeExtension
    arguments: {class: Illuminate\Config\Repository}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ConfigDynamicMethodReturnTypeExtension
    arguments: {class: Illuminate\Contracts\Config\Repository}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: 'abort', negate: false}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: 'abort', negate: true}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: throw, negate: false}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: throw, negate: true}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\AppEnvironmentReturnTypeExtension
    arguments: {class: "Illuminate\\Foundation\\Application"}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\AppEnvironmentReturnTypeExtension
    arguments: {class: "Illuminate\\Contracts\\Foundation\\Application"}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\Rules\CheckDispatchArgumentTypesCompatibleWithClassConstructorRule
    arguments: {dispatchableClass: Illuminate\Foundation\Bus\Dispatchable}
    tags: [phpstan.rules.rule]
  - class: CalebDW\PhpstanLaravel\Rules\CheckDispatchArgumentTypesCompatibleWithClassConstructorRule
    arguments: {dispatchableClass: Illuminate\Foundation\Events\Dispatchable}
    tags: [phpstan.rules.rule]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\EloquentPluckExtension
    arguments: {class: Illuminate\Database\Eloquent\Builder, templateType: TModel}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\EloquentPluckExtension
    arguments: {class: Illuminate\Database\Eloquent\Relations\Relation, templateType: TRelatedModel}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\EloquentModelKeysExtension
    arguments: {class: Illuminate\Database\Eloquent\Builder, templateType: TModel}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\EloquentModelKeysExtension
    arguments: {class: Illuminate\Database\Eloquent\Collection, templateType: TModel}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]

  # a vendor class cannot carry an attribute
  - class: Illuminate\Filesystem\Filesystem
    autowired: self
