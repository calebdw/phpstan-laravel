parameters:
  universalObjectCratesClasses:
    - Illuminate\Http\Request
    - Illuminate\Support\Optional
  earlyTerminatingFunctionCalls:
    - abort
    - dd
  mixinExcludeClasses:
    - Eloquent
  bootstrapFiles:
    - bootstrap.php
  laravel:
    rules:
      authInRequestScope: false
      batchableJobChecksCancellation: false
      batchedJobIsBatchable: false
      batchedUniqueJob: false
      configAccessor: true
      dispatchInTransactionAfterCommit: false
      envCallOutsideConfig: true
      jobSerializesModels: false
      missingTranslation: false
      modelAppends: true
      modelForwardingToBuilder: false
      modelMake: true
      modelMethodVisibility: false
      modelStaticForwardingToBuilder: false
      octaneCompatibility: false
      undefinedConfigName: false
      uniqueJobUniqueFor: false
      uniqueJobUniqueId: false
      unnecessaryCollectionCall:
        enabled: true
        only: []
        except: []
      unnecessaryEnumerableToArrayCall: true
      unusedView: false
    migrationDirectories: []
    schemaDirectories: []
    scanMigrations: true
    scanSchema: true
    sqlParser: auto
    configDirectories: []
    translationDirectories: []
    viewDirectories: []
    staticMacroClasses:
      - Illuminate\Support\Arr
      - Illuminate\Support\Str
      - Illuminate\Support\Number
      - Illuminate\Support\Benchmark
      - Illuminate\Validation\Rule
    modelPropertyType: false
    strictContracts: false

parametersSchema:
  laravel: structure([
    rules: structure([
      authInRequestScope: bool()
      batchableJobChecksCancellation: bool()
      batchedJobIsBatchable: bool()
      batchedUniqueJob: bool()
      configAccessor: bool()
      dispatchInTransactionAfterCommit: bool()
      envCallOutsideConfig: bool()
      jobSerializesModels: bool()
      missingTranslation: bool()
      modelAppends: bool()
      modelForwardingToBuilder: bool()
      modelMake: bool()
      modelMethodVisibility: bool()
      modelStaticForwardingToBuilder: bool()
      octaneCompatibility: bool()
      undefinedConfigName: bool()
      uniqueJobUniqueFor: bool()
      uniqueJobUniqueId: bool()
      unnecessaryCollectionCall: structure([
        enabled: bool()
        only: listOf(string())
        except: listOf(string())
      ])
      unnecessaryEnumerableToArrayCall: bool()
      unusedView: bool()
    ])
    migrationDirectories: listOf(string())
    schemaDirectories: listOf(string())
    scanMigrations: bool()
    scanSchema: bool()
    sqlParser: anyOf('auto', 'iamcal', 'phpmyadmin', 'postgres')
    configDirectories: listOf(string())
    translationDirectories: listOf(string())
    viewDirectories: listOf(string())
    staticMacroClasses: listOf(string())
    modelPropertyType: bool()
    strictContracts: bool()
  ])

expandRelativePaths:
  - '[parameters][laravel][configDirectories][]'
  - '[parameters][laravel][migrationDirectories][]'
  - '[parameters][laravel][schemaDirectories][]'
  - '[parameters][laravel][translationDirectories][]'
  - '[parameters][laravel][viewDirectories][]'

conditionalTags:
  CalebDW\PhpstanLaravel\Rules\NoEnvCallsOutsideOfConfigRule: {phpstan.rules.rule: %laravel.rules.envCallOutsideConfig%}
  CalebDW\PhpstanLaravel\Rules\NoModelMakeRule: {phpstan.rules.rule: %laravel.rules.modelMake%}
  CalebDW\PhpstanLaravel\Rules\NoUnnecessaryCollectionCallRule: {phpstan.rules.rule: %laravel.rules.unnecessaryCollectionCall.enabled%}
  CalebDW\PhpstanLaravel\Rules\NoUnnecessaryEnumerableToArrayCallsRule: {phpstan.rules.rule: %laravel.rules.unnecessaryEnumerableToArrayCall%}
  CalebDW\PhpstanLaravel\Rules\OctaneCompatibilityRule: {phpstan.rules.rule: %laravel.rules.octaneCompatibility%}
  CalebDW\PhpstanLaravel\Rules\UnusedViewsRule: {phpstan.rules.rule: %laravel.rules.unusedView%}
  CalebDW\PhpstanLaravel\Rules\NoMissingTranslationsRule: {phpstan.rules.rule: %laravel.rules.missingTranslation%}
  CalebDW\PhpstanLaravel\Rules\ModelAppendsRule: {phpstan.rules.rule: %laravel.rules.modelAppends%}
  CalebDW\PhpstanLaravel\Rules\ConfigAccessorRule: {phpstan.rules.rule: %laravel.rules.configAccessor%}
  CalebDW\PhpstanLaravel\Rules\UndefinedConfigNameRule: {phpstan.rules.rule: %laravel.rules.undefinedConfigName%}
  CalebDW\PhpstanLaravel\Rules\NoPublicModelScopeAndAccessorRule: {phpstan.rules.rule: %laravel.rules.modelMethodVisibility%}
  CalebDW\PhpstanLaravel\Rules\NoAuthFacadeInRequestScopeRule: {phpstan.rules.rule: %laravel.rules.authInRequestScope%}
  CalebDW\PhpstanLaravel\Rules\NoAuthHelperInRequestScopeRule: {phpstan.rules.rule: %laravel.rules.authInRequestScope%}
  CalebDW\PhpstanLaravel\Rules\NoModelForwardingToBuilderRule: {phpstan.rules.rule: %laravel.rules.modelForwardingToBuilder%}
  CalebDW\PhpstanLaravel\Rules\NoModelStaticForwardingToBuilderRule: {phpstan.rules.rule: %laravel.rules.modelStaticForwardingToBuilder%}
  CalebDW\PhpstanLaravel\Rules\Queue\UniqueJobDeclaresUniqueForRule: {phpstan.rules.rule: %laravel.rules.uniqueJobUniqueFor%}
  CalebDW\PhpstanLaravel\Rules\Queue\UniqueJobDeclaresUniqueIdRule: {phpstan.rules.rule: %laravel.rules.uniqueJobUniqueId%}
  CalebDW\PhpstanLaravel\Rules\Queue\NoBatchedUniqueJobRule: {phpstan.rules.rule: %laravel.rules.batchedUniqueJob%}
  CalebDW\PhpstanLaravel\Rules\Queue\JobWithModelPropertyDeclaresSerializesModelsRule: {phpstan.rules.rule: %laravel.rules.jobSerializesModels%}
  CalebDW\PhpstanLaravel\Rules\Queue\BatchedJobIsBatchableRule: {phpstan.rules.rule: %laravel.rules.batchedJobIsBatchable%}
  CalebDW\PhpstanLaravel\Rules\Queue\BatchableJobChecksCancellationRule: {phpstan.rules.rule: %laravel.rules.batchableJobChecksCancellation%}
  CalebDW\PhpstanLaravel\Rules\Queue\JobDispatchedInTransactionUsesAfterCommitRule: {phpstan.rules.rule: %laravel.rules.dispatchInTransactionAfterCommit%}

