    arguments: {databaseMigrationPath: %laravel.databaseMigrationsPath%, disableMigrationScan: %laravel.disableMigrationScan%, parser: @currentPhpVersionSimpleDirectParser}
  - class: CalebDW\PhpstanLaravel\Properties\SquashedMigrationHelper
    arguments: {schemaPaths: %laravel.squashedMigrationsPath%, disableSchemaScan: %laravel.disableSchemaScan%}
  - class: CalebDW\PhpstanLaravel\Properties\ModelCastHelper
  - class: CalebDW\PhpstanLaravel\Properties\ModelDatabaseHelper
  - class: CalebDW\PhpstanLaravel\Properties\ModelPropertyHelper
  - class: CalebDW\PhpstanLaravel\Rules\ModelRuleHelper
  - class: CalebDW\PhpstanLaravel\Methods\BuilderHelper
    arguments: {checkProperties: %laravel.checkModelProperties%}
  - class: CalebDW\PhpstanLaravel\Rules\RelationExistenceRule
    tags: [phpstan.rules.rule]
  - class: CalebDW\PhpstanLaravel\Rules\CheckDispatchArgumentTypesCompatibleWithClassConstructorRule
    arguments: {dispatchableClass: Illuminate\Foundation\Bus\Dispatchable}
    tags: [phpstan.rules.rule]
  - class: CalebDW\PhpstanLaravel\Rules\CheckDispatchArgumentTypesCompatibleWithClassConstructorRule
    arguments: {dispatchableClass: Illuminate\Foundation\Events\Dispatchable}
    tags: [phpstan.rules.rule]
  - class: CalebDW\PhpstanLaravel\Properties\Schema\PhpMyAdminDataTypeToPhpTypeConverter
