    tags: [phpstan.methodParameterClosureTypeExtension]
  - class: CalebDW\PhpstanLaravel\Parameters\ModelRelationParameterExtension
    tags: [phpstan.staticMethodParameterClosureTypeExtension]
  - class: CalebDW\PhpstanLaravel\Parameters\RelationClosureHelper
  - class: CalebDW\PhpstanLaravel\ReturnTypes\AppMakeHelper
  - class: CalebDW\PhpstanLaravel\Internal\ConsoleApplicationResolver
  - class: CalebDW\PhpstanLaravel\Internal\ConsoleApplicationHelper
  - class: CalebDW\PhpstanLaravel\Internal\FileHelper
  - class: CalebDW\PhpstanLaravel\Support\HigherOrderCollectionProxyHelper
  - class: CalebDW\PhpstanLaravel\Support\ConfigHelper
  - class: CalebDW\PhpstanLaravel\Support\PluckHelper
  - class: CalebDW\PhpstanLaravel\ReturnTypes\FormRequestSafeDynamicMethodReturnTypeExtension
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\Rules\NoAuthFacadeInRequestScopeRule
  - class: CalebDW\PhpstanLaravel\Rules\NoAuthHelperInRequestScopeRule
  - class: CalebDW\PhpstanLaravel\Rules\NoModelForwardingToBuilder
  - class: CalebDW\PhpstanLaravel\Rules\NoModelStaticForwardingToBuilder
  - class: Illuminate\Filesystem\Filesystem
    autowired: self
  - class: CalebDW\PhpstanLaravel\Ignore\FacadeStaticCallIgnoreExtension
    tags: [phpstan.ignoreErrorExtension]

rules:
  - CalebDW\PhpstanLaravel\Rules\UselessConstructs\NoUselessWithFunctionCallsRule
  - CalebDW\PhpstanLaravel\Rules\UselessConstructs\NoUselessValueFunctionCallsRule
  - CalebDW\PhpstanLaravel\Rules\DeferrableServiceProviderMissingProvidesRule
  - CalebDW\PhpstanLaravel\Rules\ConsoleCommand\UndefinedArgumentOrOptionRule
