parameters:
  universalObjectCratesClasses:
    - Illuminate\Http\Request
    - Illuminate\Support\Optional
  earlyTerminatingFunctionCalls:
    - abort
    - dd
  mixinExcludeClasses:
    - Eloquent
  bootstrapFiles:
    - bootstrap.php
  laravel:
    checkOctaneCompatibility: false
    noEnvCallsOutsideOfConfig: true
    noModelMake: true
    noUnnecessaryCollectionCall: true
    noUnnecessaryCollectionCallOnly: []
    noUnnecessaryCollectionCallExcept: []
    noUnnecessaryEnumerableToArrayCalls: false
    squashedMigrationsPath: []
    databaseMigrationsPath: []
    disableMigrationScan: false
    disableSchemaScan: false
    configDirectories: []
    viewDirectories: []
    translationDirectories: []
    checkModelProperties: false
    checkUnusedViews: false
    checkMissingTranslations: false
    checkModelAppends: true
    checkModelMethodVisibility: false
    checkAuthCallsWhenInRequestScope: false
    noModelForwardingToBuilder: false
    noModelStaticForwardingToBuilder: false

parametersSchema:
  laravel: structure([
    checkOctaneCompatibility: bool()
    noEnvCallsOutsideOfConfig: bool()
    noModelMake: bool()
    noUnnecessaryCollectionCall: bool()
    noUnnecessaryCollectionCallOnly: listOf(string())
    noUnnecessaryCollectionCallExcept: listOf(string())
    noUnnecessaryEnumerableToArrayCalls: bool()
    databaseMigrationsPath: listOf(string())
    disableMigrationScan: bool()
    configDirectories: listOf(string())
    viewDirectories: listOf(string())
    translationDirectories: listOf(string())
    squashedMigrationsPath: listOf(string())
    disableSchemaScan: bool()
    checkModelProperties: bool()
    checkUnusedViews: bool()
    checkMissingTranslations: bool()
    checkModelAppends: bool()
    checkModelMethodVisibility: bool()
    checkAuthCallsWhenInRequestScope: bool()
    noModelForwardingToBuilder: bool()
    noModelStaticForwardingToBuilder: bool()
  ])

conditionalTags:
  CalebDW\PhpstanLaravel\Rules\NoEnvCallsOutsideOfConfigRule: {phpstan.rules.rule: %laravel.noEnvCallsOutsideOfConfig%}
  CalebDW\PhpstanLaravel\Rules\NoModelMakeRule: {phpstan.rules.rule: %laravel.noModelMake%}
  CalebDW\PhpstanLaravel\Rules\NoUnnecessaryCollectionCallRule: {phpstan.rules.rule: %laravel.noUnnecessaryCollectionCall%}
  CalebDW\PhpstanLaravel\Rules\NoUnnecessaryEnumerableToArrayCallsRule: {phpstan.rules.rule: %laravel.noUnnecessaryEnumerableToArrayCalls%}
  CalebDW\PhpstanLaravel\Rules\OctaneCompatibilityRule: {phpstan.rules.rule: %laravel.checkOctaneCompatibility%}
  CalebDW\PhpstanLaravel\Rules\UnusedViewsRule: {phpstan.rules.rule: %laravel.checkUnusedViews%}
  CalebDW\PhpstanLaravel\Rules\NoMissingTranslationsRule: {phpstan.rules.rule: %laravel.checkMissingTranslations%}
  CalebDW\PhpstanLaravel\Rules\ModelAppendsRule: {phpstan.rules.rule: %laravel.checkModelAppends%}
  CalebDW\PhpstanLaravel\Rules\NoPublicModelScopeAndAccessorRule: {phpstan.rules.rule: %laravel.checkModelMethodVisibility%}
  CalebDW\PhpstanLaravel\Rules\NoAuthFacadeInRequestScopeRule: {phpstan.rules.rule: %laravel.checkAuthCallsWhenInRequestScope%}
  CalebDW\PhpstanLaravel\Rules\NoAuthHelperInRequestScopeRule: {phpstan.rules.rule: %laravel.checkAuthCallsWhenInRequestScope%}
  CalebDW\PhpstanLaravel\Rules\NoModelForwardingToBuilder: {phpstan.rules.rule: %laravel.noModelForwardingToBuilder%}
  CalebDW\PhpstanLaravel\Rules\NoModelStaticForwardingToBuilder: {phpstan.rules.rule: %laravel.noModelStaticForwardingToBuilder%}

services:
  - class: CalebDW\PhpstanLaravel\Methods\RelationForwardsCallsExtension
    tags: [phpstan.broker.methodsClassReflectionExtension]
  - class: CalebDW\PhpstanLaravel\Methods\ModelForwardsCallsExtension
    tags: [phpstan.broker.methodsClassReflectionExtension]
  - class: CalebDW\PhpstanLaravel\Methods\EloquentBuilderForwardsCallsExtension
