    tags: [phpstan.collector]
  - class: CalebDW\PhpstanLaravel\Collectors\UsedViewInAnotherViewCollector
  - class: CalebDW\PhpstanLaravel\Support\ViewFileHelper
    arguments: {viewDirectories: %laravel.viewDirectories%}
  - class: CalebDW\PhpstanLaravel\Support\ViewParser
    arguments: {parser: @currentPhpVersionSimpleDirectParser}
  - class: CalebDW\PhpstanLaravel\Rules\NoMissingTranslationsRule
    arguments: {translationDirectories: %laravel.translationDirectories%}
  - class: CalebDW\PhpstanLaravel\Collectors\UsedTranslationFunctionCollector
    tags: [phpstan.collector]
  - class: CalebDW\PhpstanLaravel\Collectors\UsedTranslationTranslatorCollector
    tags: [phpstan.collector]
  - class: CalebDW\PhpstanLaravel\Collectors\UsedTranslationFacadeCollector
    tags: [phpstan.collector]
  - class: CalebDW\PhpstanLaravel\Collectors\UsedTranslationViewCollector
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ApplicationMakeDynamicReturnTypeExtension
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ContainerMakeDynamicReturnTypeExtension
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ConsoleCommand\ArgumentDynamicReturnTypeExtension
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ConsoleCommand\HasArgumentDynamicReturnTypeExtension
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ConsoleCommand\OptionDynamicReturnTypeExtension
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\ConsoleCommand\HasOptionDynamicReturnTypeExtension
