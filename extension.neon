  - class: CalebDW\PhpstanLaravel\ReturnTypes\LangGetReturnTypeExtension
    tags: [phpstan.broker.dynamicStaticMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\TransHelperReturnTypeExtension
    tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\DoubleUnderscoreHelperReturnTypeExtension
