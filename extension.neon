    arguments: {class: "Illuminate\\Foundation\\Application"}
    tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
  - class: CalebDW\PhpstanLaravel\ReturnTypes\AppEnvironmentReturnTypeExtension
