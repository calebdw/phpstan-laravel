  - class: CalebDW\PhpstanLaravel\Rules\NoModelMakeRule
  - class: CalebDW\PhpstanLaravel\Rules\NoUnnecessaryCollectionCallRule
    arguments: {onlyMethods: %laravel.noUnnecessaryCollectionCallOnly%, excludeMethods: %laravel.noUnnecessaryCollectionCallExcept%}
  - class: CalebDW\PhpstanLaravel\Rules\NoUnnecessaryEnumerableToArrayCallsRule
  - class: CalebDW\PhpstanLaravel\Rules\ModelAppendsRule
  - class: CalebDW\PhpstanLaravel\Rules\NoPublicModelScopeAndAccessorRule
