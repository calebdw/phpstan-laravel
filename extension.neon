    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: 'abort', negate: true}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: throw, negate: false}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
  - class: CalebDW\PhpstanLaravel\Types\AbortIfFunctionTypeSpecifyingExtension
    arguments: {methodName: throw, negate: true}
    tags: [phpstan.typeSpecifier.functionTypeSpecifyingExtension]
