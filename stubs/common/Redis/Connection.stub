<?php

namespace Illuminate\Redis {
    class RedisManager implements \Illuminate\Contracts\Redis\Factory {}
}

namespace Illuminate\Redis\Connections {
    /**
     * @mixin \Redis
     */
    abstract class Connection
    {
        public function eval(string $script, int $numberOfKeys, mixed ...$arguments): mixed {}

        public function evalsha(string $script, int $numberOfKeys, mixed ...$arguments): mixed {}
    }
}
