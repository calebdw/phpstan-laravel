<?php

namespace Illuminate\Contracts\Validation;

/**
 * @template TValidated of array = array<string, mixed>
 */
interface Validator
{
    /**
     * @return TValidated
     *
     * @throws \Illuminate\Validation\ValidationException
     */
    public function validate();

    /**
     * @return TValidated
     *
     * @throws \Illuminate\Validation\ValidationException
     */
    public function validated();
}
